SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
RJSHEETAL_TOKEN=generate_a_long_random_string
PORT=8080
RJSHEETAL_DATA=/data
RJSHEETAL_LISTENER_NAME=Sheetal
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=hRKCLdG8a4wR6WPgMGQr
ELEVENLABS_MODEL_ID=eleven_v3_conversational
ELEVENLABS_AGENT_ID=agent_8401m2cyznemf10tav3hh90nqya1
# Nango provides the hosted Gmail connection UI, token refresh, and proxy.
NANGO_SECRET_KEY=your_nango_secret_key
NANGO_API_BASE=https://api.nango.dev
NANGO_INTEGRATION_ID=gmail
NANGO_USER_ID=sheetal
# Temporary starter PIN; Sheetal can change it from the connected-app panel.
RJSHEETAL_PRIVATE_CODE=0000000
# Optional secret for an ElevenLabs custom Gmail tool; falls back to RJSHEETAL_TOKEN.
RJSHEETAL_AGENT_TOKEN=optional_agent_webhook_token
