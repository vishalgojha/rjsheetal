# Copy to .env (or set in Coolify) — never commit real secrets.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
RJSHEETAL_TOKEN=generate_a_long_random_string
PORT=8080
RJSHEETAL_DATA=/data
RJSHEETAL_LISTENER_NAME=Sheetal
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_sheetal_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
